{
  "name": "onboarding-buddy",
  "displayName": "Onboarding Buddy",
  "description": "Persistent AI mentor grounded in your VS Code workspace.",
  "version": "0.1.0",
  "publisher": "onboarding-buddy",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Education"],
  "activationEvents": [
    "onView:onboardingBuddy.chat",
    "onCommand:onboardingBuddy.open",
    "onCommand:onboardingBuddy.signIn",
    "onCommand:onboardingBuddy.syncProject"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onboardingBuddy",
          "title": "Onboarding Buddy",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "onboardingBuddy": [
        {
          "type": "webview",
          "id": "onboardingBuddy.chat",
          "name": "Mentor"
        }
      ]
    },
    "commands": [
      {
        "command": "onboardingBuddy.open",
        "title": "Onboarding Buddy: Open Mentor"
      },
      {
        "command": "onboardingBuddy.signIn",
        "title": "Onboarding Buddy: Sign in with GitHub"
      },
      {
        "command": "onboardingBuddy.syncProject",
        "title": "Onboarding Buddy: Sync Current Project"
      }
    ],
    "configuration": {
      "title": "Onboarding Buddy",
      "properties": {
        "onboardingBuddy.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Backend API URL (e.g. https://your-backend.onrender.com or http://127.0.0.1:8000)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
